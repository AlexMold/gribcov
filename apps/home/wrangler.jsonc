{
  // Cloudflare Pages: gribcov.me (advanced mode, _worker.js)
  // Deploy: npx wrangler pages deploy apps/home --project-name gribcov
  "name": "gribcov",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-09-01",
  // Visit source tracking (?ref=cv / ?ref=linkedin / utm_source / referer host)
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "JOBFIT_KV", "id": "5475f5e3880b4a52bb0d03b04d2cf7df" }
  ],
  "analytics_engine_datasets": [
    { "binding": "VISITS", "dataset": "gribcov_visits" },
    { "binding": "JOBFIT_AE", "dataset": "gribcov_jobfit" }
  ]
}
